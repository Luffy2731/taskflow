          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"status = done\", () => pm.expect(pm.response.json().status).to.eql(\"done\"));"
            ]
          }
        }
      ]
